{
  "format": "teleprompter-package@1",
  "name": "versionado",
  "version": "0.8.0",
  "description": "Ciclo de liberaciones: mantenimiento del changelog y liberación de versiones",
  "license": "MIT",
  "author": {
    "name": "Gildardo Adrian Maravilla Jacome"
  },
  "install": [
    {
      "source": "skills/liberar-version/",
      "target": ".agents/skills/liberar-version/"
