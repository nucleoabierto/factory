{
  "format": "teleprompter-package@1",
  "name": "flujo-ideas",
  "version": "0.8.0",
  "description": "De la idea suelta a las tareas definitivas: descubrimiento, propuesta y promoción",
  "license": "MIT",
  "author": {
    "name": "Gildardo Adrian Maravilla Jacome"
  },
  "install": [
    {
      "source": "skills/idea-a-tarea/",
      "target": ".agents/skills/idea-a-tarea/"
    },
    {
      "source": "skills/lluvia-de-ideas/",
      "target": ".agents/skills/lluvia-de-ideas/"
    },
    {
      "source": "skills/descubrir-problema/",
      "target": ".agents/skills/descubrir-problema/"
    },
    {
      "source": "skills/proponer-forma-solucion/",
      "target": ".agents/skills/proponer-forma-solucion/"
    },
    {
      "source": "skills/refinar-propuesta/",
      "target": ".agents/skills/refinar-propuesta/"
    },
    {
      "source": "skills/crear-tareas/",
      "target": ".agents/skills/crear-tareas/"
    }
  ],
  "requires": {
    "paths": [
      {
        "path": ".agents/skills/",
        "create": true
      }
