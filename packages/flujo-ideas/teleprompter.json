  "dependencies": [
    {
      "package": "direccion",
      "version": ">=0.8.0 <1.0.0"
    },
    {
      "package": "evidencia",
      "version": ">=0.8.0 <1.0.0"
    },
    {
      "package": "gestores",
      "version": ">=0.8.0 <1.0.0"
    }
  ],
  "personalization": "PERSONALIZE.md",
  "metadata": {
    "idioma": "es"
  }
}
